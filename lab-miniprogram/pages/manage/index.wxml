<view class="page"><view class="title">{{title}}</view><view class="card"><view wx:if="{{summary}}" class="detail">设备 #{{summary.equipmentId}}
{{summary.orderNo || ''}}
{{summary.startTime || ''}} {{summary.endTime || ''}}
{{summary.purpose || summary.description || ''}}</view><radio-group wx:if="{{action === 'audit'}}" bindchange="approval"><label><radio value="true" checked="{{approved}}"/>通过</label><label><radio value="false" checked="{{!approved}}"/>拒绝</label></radio-group><text class="label">处理说明（拒绝预约、完成维修时必填）</text><textarea value="{{content}}" data-field="content" bindinput="input" maxlength="{{action === 'audit' ? 500 : 2000}}" placeholder="请填写处理说明"/><block wx:if="{{action === 'complete'}}"><text class="label">维修费用（元）</text><input type="digit" value="{{repairCost}}" data-field="repairCost" bindinput="input"/></block><view class="error" wx:if="{{error}}">{{error}}</view><button class="primary" bindtap="submit" disabled="{{busy || loading || stale}}" loading="{{busy}}">确认提交</button></view></view>