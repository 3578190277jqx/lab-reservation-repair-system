<view class="page"><view class="card"><view class="title">故障报修</view><view class="name">{{equipment.name || '读取设备信息中'}}</view><text class="label">故障描述</text><textarea data-field="description" bindinput="input" maxlength="2000" placeholder="请描述故障现象、出现时间等信息"/><button bindtap="chooseImage" loading="{{uploading}}" disabled="{{busy || uploading}}">{{imageUrl ? '更换图片' : '上传故障图片（可选）'}}</button><image wx:if="{{localImage}}" class="image" src="{{localImage}}" mode="aspectFit"/><button wx:if="{{imageUrl}}" bindtap="removeImage" disabled="{{busy || uploading}}">移除图片</button><view class="row" wx:if="{{imageUrl}}"><text>请求AI辅助识别</text><switch checked="{{analyzeImage}}" bindchange="ai"/></view><view class="hint">仅支持JPEG/PNG，不超过5MB。启用辅助识别会由后端将图片发送至已配置的AI服务（当前为阿里云千问）；结果仅供参考，不影响报修流程。请勿上传个人敏感信息。</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!equipment}}" bindtap="load">重新读取设备</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploading || !equipment}}">提交报修</button></view></view>
