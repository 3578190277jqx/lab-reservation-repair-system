<view class="page {{manager ? 'theme-admin' : 'theme-student'}}"><view class="hero profile-hero"><view class="eyebrow">ACCOUNT / 我的实验室</view><view class="title">{{user.realName || '个人中心'}}</view><view class="muted">{{user.role === 'student' ? '学生' : user.role === 'admin' ? '超级管理员' : '实验室管理员'}} · 实验室服务</view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view class="card" wx:if="{{user}}"><view class="detail">用户名：{{user.username}}
学号：{{user.studentNo || '未填写'}}
手机号：{{user.phone || '未填写'}}
邮箱：{{user.email || '未填写'}}</view></view><view class="card contact-card"><view class="name">账号安全 · 找回邮箱</view><view class="hint">{{user.emailVerified === 1 ? '当前邮箱已验证' : '请先验证绑定QQ邮箱'}}；短信找回待开放。</view><input value="{{email}}" data-field="email" bindinput="input" maxlength="128" placeholder="QQ邮箱@qq.com"/><input value="{{emailCode}}" data-field="emailCode" bindinput="input" type="number" maxlength="6" placeholder="6位邮箱验证码"/><button bindtap="sendCode" disabled="{{codeBusy || busy || cooldown > 0}}" loading="{{codeBusy}}">{{cooldown ? cooldown+'秒后重试' : '发送验证码'}}</button><input value="{{currentPassword}}" data-field="currentPassword" bindinput="input" password maxlength="64" placeholder="当前登录密码"/><button bindtap="bind" loading="{{busy}}" disabled="{{busy}}">验证并绑定</button></view><view class="card"><view class="name">使用说明</view><button bindtap="assistant">操作助手 · 预约与报修问答</button><view class="hint">请按时到场签到，爽约可能影响后续预约。管理员可在小程序预约、报修页面办理审核与维修。</view><button wx:if="{{user.role === 'admin' || user.role === 'lab_admin'}}" bindtap="stats">统计总览</button><button bindtap="logout" loading="{{busy}}" disabled="{{busy}}">退出登录</button></view></view>
