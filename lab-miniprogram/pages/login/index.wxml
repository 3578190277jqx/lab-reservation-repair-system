<view class="page"><view class="hero"><view class="title">实验室预约与报修</view><view class="muted">预约设备，随时查看实验安排</view></view><view class="card"><view class="name">账号登录</view><text class="label">用户名</text><input value="{{username}}" data-field="username" bindinput="input" maxlength="32" placeholder="请输入系统账号"/><text class="label">密码</text><input value="{{password}}" data-field="password" bindinput="input" password maxlength="64" placeholder="请输入密码"/><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录</button><button bindtap="recover">忘记密码？QQ邮箱找回</button><button bindtap="register">注册学生账号</button><view class="hint">使用网页端已有账号登录，支持学生、实验室管理员和超级管理员。</view></view></view>
