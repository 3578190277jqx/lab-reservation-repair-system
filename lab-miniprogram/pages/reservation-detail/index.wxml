<view class="page {{manager ? 'theme-admin' : 'theme-student'}}"><view class="page-heading"><view class="title">预约进度</view><view class="hint">下拉可刷新最新进度</view></view>
 <view wx:if="{{busy}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
 <view wx:if="{{row}}" class="card"><view class="item-heading"><view class="name">{{row.equipmentName || ('设备 #'+row.equipmentId)}}</view><text class="tag">{{row.statusText}}</text></view><view class="hint">{{row.labName || '实验室未提供'}} · {{row.labLocation || '位置未登记'}}</view><view class="detail">{{row.purpose || row.description}}</view><view wx:if="{{row.startTime}}" class="notice">{{row.startTime}} 至 {{row.endTime}}（北京时间）</view><view wx:if="{{row.aiSuggestion}}" class="notice">AI参考提示：{{row.aiSuggestion}}</view></view>
 <view class="card" wx:for="{{rows}}" wx:key="index"><view class="tag">{{item.title}}</view><view class="hint">{{item.time}}</view><view class="detail">{{item.content || '暂无说明'}}</view><view class="hint" wx:if="{{item.repairCost != null}}">维修费用：¥{{item.repairCost}}</view></view><view class="empty" wx:if="{{row && !busy && !error && !rows.length}}">暂无处理记录</view></view>
