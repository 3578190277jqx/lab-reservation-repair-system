.shortcut-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-bottom:24rpx}.shortcut{margin:0;padding:24rpx;text-align:left;background:#fff;border:1rpx solid #dce7eb;border-radius:20rpx;line-height:1.6;white-space:normal}.shortcut .name{font-size:28rpx}.shortcut .hint{font-size:23rpx;margin-top:10rpx}.answer-actions{margin-top:20rpx}.answer-actions button{font-size:26rpx;color:#087f70}.navigation-notice{border:2rpx solid #087f70;background:#f0faf7}.detail{white-space:pre-wrap;word-break:break-all}textarea{box-sizing:border-box;width:100%}
