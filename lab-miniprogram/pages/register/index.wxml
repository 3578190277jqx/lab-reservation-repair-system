<view class="page"><view class="card"><view class="title">创建学生账号</view><text class="label">用户名</text><input data-field="username" bindinput="input" maxlength="32" placeholder="4–32位字母、数字、下划线"/><text class="label">姓名</text><input data-field="realName" bindinput="input" maxlength="64"/><text class="label">学号</text><input data-field="studentNo" bindinput="input" maxlength="32"/><text class="label">密码</text><input data-field="password" bindinput="input" password maxlength="64"/><text class="label">确认密码</text><input data-field="confirmPassword" bindinput="input" password maxlength="64"/><text class="label">QQ邮箱（用于找回密码）</text><input data-field="email" value="{{email}}" bindinput="input" maxlength="128" placeholder="你的QQ邮箱@qq.com"/><text class="label">手机号（选填，短信找回待开放）</text><input data-field="phone" value="{{phone}}" bindinput="input" maxlength="11" type="number"/><text class="label">邮箱验证码</text><input data-field="emailCode" value="{{emailCode}}" bindinput="input" maxlength="6" type="number"/><button bindtap="sendCode" loading="{{codeBusy}}" disabled="{{busy || codeBusy || cooldown > 0}}">{{cooldown ? cooldown+'秒后重试':'发送邮箱验证码'}}</button><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">注册</button></view></view>
