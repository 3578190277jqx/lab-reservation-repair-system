<view class="page {{manager ? 'theme-admin' : 'theme-student'}}">
  <view class="page-heading"><view class="eyebrow">{{manager ? 'REVIEW / 预约审核' : 'MY SCHEDULE / 我的安排'}}</view><view class="title">{{manager ? '让实验安排，有序进行' : '每一场实验，都有安排'}}</view><view class="muted">{{manager ? '查看预约用途与时段，及时处理申请' : '跟进申请进度，记得按时到场签到'}}</view></view>
  <scroll-view class="filter-scroll" scroll-x><view class="filter-tabs"><button wx:for="{{statuses}}" wx:key="*this" class="filter-chip {{statusIndex === index ? 'selected' : ''}}" bindtap="chip" data-index="{{index}}">{{item}}</button></view></scroll-view>
  <view class="notice">北京时间 · 预约开始后 30 分钟内且结束前可签到</view>
  <view class="list-caption"><text>{{manager ? '预约申请' : '我的预约'}}</text><text>{{total === null ? (busy ? '正在加载' : '暂未获取') : '共 ' + total + ' 条'}}</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="search">重新加载</button></view><view wx:if="{{busy && !rows.length}}" class="loading-panel"><view class="skeleton wide"></view><view class="skeleton"></view></view>
  <view wx:for="{{rows}}" wx:key="id" class="card reservation-card"><view class="item-heading"><view class="name">{{item.equipmentName || ('设备 #' + item.equipmentId)}}</view><text class="tag status-{{item.status}}">{{item.statusText}}</text></view><view class="hint">预约编号 #{{item.id}}</view>
    <view class="time-block"><view class="time-line"><text class="time-dot"></text><text class="meta-label">开始</text><text>{{item.startTime}}</text></view><view class="time-line"><text class="time-dot end-dot"></text><text class="meta-label">结束</text><text>{{item.endTime}}</text></view></view>
    <view class="detail"><text class="meta-label">实验用途 </text>{{item.purpose || '未填写'}}</view><view wx:if="{{item.auditRemark}}" class="notice">{{item.status === 5 ? '系统说明' : '审核说明'}}：{{item.auditRemark}}</view><view wx:if="{{item.signInTime}}" class="notice success-notice">已签到 · {{item.signInTime}}</view>
    <view wx:if="{{item.labName}}" class="hint">{{item.labName}} · {{item.labLocation || '位置未登记'}}</view><view class="row"><button class="secondary" bindtap="detail" data-id="{{item.id}}">进度详情</button><button wx:if="{{manager && item.status === 0}}" class="primary" bindtap="manage" data-id="{{item.id}}" data-action="audit">审核这条预约</button><button wx:if="{{item.canSignIn}}" class="primary" bindtap="action" data-action="signIn" data-id="{{item.id}}" disabled="{{actionBusy}}">到场签到</button><button wx:if="{{item.canCancel}}" class="secondary" bindtap="action" data-action="cancel" data-id="{{item.id}}" disabled="{{actionBusy}}">取消预约</button></view>
  </view>
  <view wx:if="{{!busy && !rows.length && !error}}" class="empty card"><view class="empty-symbol">✓</view>{{manager ? '当前筛选下没有预约申请' : '当前筛选下没有预约'}}<view class="hint">{{manager ? '切换状态或下拉刷新，查看其他预约。' : '切换状态查看记录，也可以开始新的实验安排。'}}</view><button wx:if="{{!manager}}" class="primary" bindtap="browse">去找实验设备</button></view>
  <button wx:if="{{hasMore && rows.length}}" class="load-more" bindtap="more" loading="{{busy}}" disabled="{{busy}}">加载更多预约</button><view wx:if="{{!hasMore && rows.length}}" class="page-footer">已显示全部预约</view>
</view>
