<view class="page {{manager ? 'theme-admin' : 'theme-student'}}">
  <view class="page-heading"><view class="eyebrow">{{manager ? 'MAINTENANCE / 工单运维' : 'REPAIR / 故障反馈'}}</view><view class="title">{{manager ? '跟进每一张维修工单' : '每一次反馈，都有进展'}}</view><view class="muted">{{manager ? '受理、维修、完成，处理过程清晰可查' : '从故障提交到修复完成，随时查看进度'}}</view></view>
  <view wx:if="{{manager}}" class="scope-switch"><picker range="{{scopes}}" value="{{scopeIndex}}" bindchange="scope"><view class="picker">{{scopes[scopeIndex]}} <text>⌄</text></view></picker></view>
  <scroll-view class="filter-scroll" scroll-x><view class="filter-tabs"><button wx:for="{{statuses}}" wx:key="*this" class="filter-chip {{statusIndex === index ? 'selected' : ''}}" bindtap="chip" data-index="{{index}}">{{item}}</button></view></scroll-view>
  <view class="list-caption"><text>{{manager && scopeIndex === 0 ? '管理范围内的工单' : '我提交的报修'}}</text><text>{{total === null ? (busy ? '正在加载' : '暂未获取') : '共 ' + total + ' 条'}}</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="search">重新加载</button></view><view wx:if="{{busy && !rows.length}}" class="loading-panel"><view class="skeleton wide"></view><view class="skeleton"></view></view>
  <view wx:for="{{rows}}" wx:key="id" class="card repair-card"><view class="item-heading"><view class="name">{{item.equipmentName || ('设备 #' + item.equipmentId)}}</view><text class="tag repair-status-{{item.status}}">{{item.statusText}}</text></view><view class="hint">{{item.orderNo || ('工单 #' + item.id)}} · {{item.createTime}}</view><view class="repair-description">{{item.description}}</view>
    <view class="repair-steps"><view class="step {{item.status >= 0 ? 'done' : ''}}"><text class="step-node">1</text><text>已提交</text></view><view class="step {{item.status >= 1 ? 'done' : ''}}"><text class="step-node">2</text><text>已受理</text></view><view class="step {{item.status >= 2 ? 'done' : ''}}"><text class="step-node">3</text><text>维修中</text></view><view class="step {{item.status >= 3 ? 'done' : ''}}"><text class="step-node">4</text><text>已完成</text></view></view>
    <view wx:if="{{item.aiSuggestion}}" class="notice"><text class="strong">AI 辅助提示 · 仅供参考</text><view>{{item.aiSuggestion}}</view></view>
    <view class="row"><button wx:if="{{item.canHandle && item.status < 3}}" class="primary" bindtap="manage" data-id="{{item.id}}" data-action="{{item.status === 0 ? 'accept' : item.status === 1 ? 'start' : 'complete'}}">{{item.status === 0 ? '受理工单' : item.status === 1 ? '开始维修' : '完成维修'}}</button><button class="secondary" bindtap="records" data-id="{{item.id}}">维修记录</button></view><button wx:if="{{item.imageUrl}}" class="text-button attachment-button" bindtap="preview" data-path="{{item.imageUrl}}">查看故障图片 →</button>
  </view>
  <view wx:if="{{!busy && !rows.length && !error}}" class="empty card"><view class="empty-symbol">✓</view>当前筛选下没有工单<view class="hint">遇到设备问题，可从设备页提交故障报修。</view><button bindtap="browse">查看实验设备</button></view>
  <button wx:if="{{hasMore && rows.length}}" class="load-more" bindtap="more" loading="{{busy}}" disabled="{{busy}}">加载更多工单</button><view wx:if="{{!hasMore && rows.length}}" class="page-footer">已显示全部工单</view>
</view>
