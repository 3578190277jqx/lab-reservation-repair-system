page { background: #f5f7fa; color: #243448; font-size: 28rpx; line-height: 1.5; }
.page { padding: 32rpx 28rpx 52rpx; min-height: 100vh; box-sizing: border-box; }
.hero { position: relative; overflow: hidden; padding: 36rpx; background: #0a665c; color: #fff; border-radius: 28rpx; margin-bottom: 28rpx; }
.title { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.45; margin-bottom: 16rpx; }
.muted { color: #728095; font-size: 25rpx; line-height: 1.7; }
.hero .muted { color: #d1ebe7; }
.hero .eyebrow { color: #c2e2da; }
.card { background: #fff; border: 1rpx solid #ebeff3; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(26,47,68,.025); }
.name { font-size: 31rpx; font-weight: 650; margin-bottom: 12rpx; overflow-wrap: break-word; }
.label { display: block; margin: 28rpx 0 12rpx; font-weight: 600; font-size: 26rpx; }
input, textarea, .picker { width: 100%; box-sizing: border-box; padding: 22rpx; background: #f4f6f9; border-radius: 14rpx; min-height: 88rpx; font-size: 28rpx; }
textarea { height: 220rpx; }
.row { display: flex; gap: 16rpx; align-items: center; margin-top: 24rpx; }
.row:empty { display: none; }
.row button, .row picker { flex: 1; min-width: 0; }
button { font-size: 27rpx; font-weight: 600; border-radius: 14rpx; margin-top: 24rpx; min-height: 88rpx; line-height: 1.4; padding: 22rpx 18rpx; color: #33475b; background: #f3f6f9; }
button.primary { background: #087f70; color: #fff; }
button.secondary { color: #087f70; background: #edf7f4; }
button[disabled] { opacity: .55; }
button::after { border: 0; }
.row button { margin: 0; }
.tag { display: inline-block; flex-shrink: 0; color: #087f70; background: #e7f5ee; padding: 6rpx 15rpx; border-radius: 9rpx; font-size: 22rpx; font-weight: 500; white-space: nowrap; }
.status-1, .repair-status-1 { color: #315ee7; background: #edf1ff; }
.status-2, .repair-status-0 { color: #a76617; background: #fff4e4; }
.status-3, .status-5 { color: #778394; background: #f0f2f5; }
.status-4 { color: #bd4a45; background: #fff0ef; }
.repair-status-2 { color: #8259be; background: #f2edfb; }
.repair-status-3 { color: #087f70; background: #e7f5ee; }
.empty { text-align: center; padding: 42rpx 24rpx; color: #5f7084; }
.empty-symbol { display: block; margin: 0 auto 20rpx; width: 72rpx; height: 72rpx; line-height: 72rpx; font-size: 34rpx; color: #82a4a0; background: #eef5f4; border-radius: 50%; }
.error { color: #ab3b31; background: #fff0ed; padding: 24rpx; border-radius: 16rpx; margin: 20rpx 0; word-break: break-all; }
.error button { background: #fff; color: #ab3b31; }
.hint { font-size: 23rpx; color: #7b8899; line-height: 1.8; margin-top: 12rpx; word-break: break-word; }
.image { width: 100%; height: 340rpx; border-radius: 16rpx; margin-top: 20rpx; }
.link { color: #087f70; }
.detail { line-height: 1.9; white-space: pre-wrap; word-break: break-word; }
.eyebrow { font-size: 21rpx; color: #7c8c9b; letter-spacing: 3rpx; font-weight: 600; margin-bottom: 14rpx; }
.page-heading { margin: 8rpx 0 30rpx; }
.page-heading .title { font-size: 39rpx; margin-bottom: 10rpx; }
.small { font-size: 23rpx; }
.strong { font-weight: 600; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.welcome { position: relative; padding: 0 0 30rpx; }
.welcome-name { font-size: 32rpx; font-weight: 650; padding-right: 170rpx; overflow-wrap: break-word; }
.role-pill { position: absolute; bottom: 32rpx; right: 0; padding: 6rpx 16rpx; border: 1rpx solid #d5e5e1; color: #087f70; border-radius: 30rpx; font-size: 21rpx; }
.home-hero { background: linear-gradient(120deg, #0a675c, #159080); padding: 36rpx; min-height: 252rpx; }
.home-hero .title { position: relative; z-index: 1; font-size: 41rpx; max-width: 580rpx; }
.home-hero .muted { position: relative; z-index: 1; font-size: 24rpx; }
.hero-action { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: space-between; gap: 34rpx; background: #fff; color: #087164; font-size: 25rpx; min-height: 76rpx; padding: 19rpx 26rpx; margin-top: 30rpx; }
.hero-orbit { position: absolute; width: 280rpx; height: 280rpx; border: 1rpx solid rgba(255,255,255,.16); border-radius: 50%; right: -70rpx; bottom: -125rpx; pointer-events: none; }
.orbit-two { width: 360rpx; height: 360rpx; right: -110rpx; bottom: -165rpx; }
.quick-grid { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.quick-card { position: relative; flex: 1; min-width: 0; border-radius: 22rpx; margin: 0; padding: 26rpx; text-align: left; background: #fff; border: 1rpx solid #ebeff3; font-weight: 400; }
.quick-card text { display: block; }
.quick-symbol { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 22rpx; font-weight: 600; border-radius: 16rpx; background: #ebf6f2; color: #087f70; margin-bottom: 20rpx; }
.quick-symbol.warm { color: #9b732c; background: #fff5e6; }
.metric { display: block; font-size: 46rpx; line-height: 1.25; font-weight: 700; color: #253957; margin-bottom: 8rpx; font-variant-numeric: tabular-nums; }
.shortcut-title { font-weight: 650; font-size: 29rpx; margin-bottom: 8rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 36rpx 0 20rpx; }
.section-title { font-size: 31rpx; font-weight: 650; }
.section-heading .hint { margin-top: 4rpx; }
button.text-button { margin: 0; padding: 16rpx 0 16rpx 16rpx; min-height: 72rpx; background: transparent; color: #087f70; font-size: 24rpx; flex-shrink: 0; font-weight: 500; }
.summary-strip { display: flex; text-align: center; padding: 32rpx 12rpx; }
.summary-strip > view { flex: 1; min-width: 0; border-right: 1rpx solid #ebeff3; }
.summary-strip > view:last-child { border: 0; }
.summary-strip .metric { font-size: 39rpx; }
.summary-strip .muted { display: block; font-size: 23rpx; }
.green { color: #087f70; }.amber { color: #b17a2f; }
.equipment-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.mini-equipment { box-sizing: border-box; width: 48.5%; background: #fff; border: 1rpx solid #e9efed; border-radius: 22rpx; padding: 22rpx; margin-bottom: 20rpx; min-width: 0; }
.equipment-art { height: 108rpx; background: linear-gradient(120deg,#edf7f3,#f6faf8); border-radius: 16rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 14rpx; margin-bottom: 20rpx; }
.equipment-art image { width: 62rpx; height: 62rpx; }
.equipment-art .tag { font-size: 20rpx; padding: 4rpx 10rpx; }
.mini-equipment .name { font-size: 28rpx; min-height: 42rpx; margin-bottom: 8rpx; }
button.soft-button { color: #087f70; background: #edf7f4; font-size: 23rpx; min-height: 76rpx; padding: 20rpx 10rpx; }
.feed { padding: 6rpx 28rpx; }
.feed-item { display: flex; gap: 18rpx; padding: 28rpx 0; border-bottom: 1rpx solid #eef1f5; }
.feed-item:last-child { border: 0; }
.feed-dot { flex-shrink: 0; width: 14rpx; height: 14rpx; background: #58a490; border: 7rpx solid #eef7f3; border-radius: 50%; margin-top: 10rpx; }
.feed-dot.warm { background: #d4a450; border-color: #fcf6eb; }
.feed-main { flex: 1; min-width: 0; }
.item-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.item-heading .name { min-width: 0; margin-bottom: 6rpx; }
.page-footer { text-align: center; font-size: 22rpx; color: #94a0ae; padding: 28rpx 0 8rpx; }
.loading-panel { padding: 28rpx; background: #fff; border-radius: 20rpx; margin-bottom: 24rpx; }
.skeleton { height: 28rpx; border-radius: 6rpx; width: 55%; background: #eef2f6; margin-bottom: 20rpx; }
.skeleton.wide { width: 85%; height: 36rpx; }
.search-card { padding: 16rpx; margin-bottom: 20rpx; }
.search-line { display: flex; gap: 16rpx; align-items: center; }
.search-line input { flex: 1; min-width: 0; }
.search-line button { margin: 0; padding: 24rpx; min-width: 112rpx; flex-shrink: 0; }
.filter-scroll { width: 100%; margin: 20rpx 0 12rpx; white-space: nowrap; }
.filter-tabs { display: inline-flex; padding: 4rpx 0 12rpx; gap: 12rpx; }
button.filter-chip { display: inline-block; margin: 0; padding: 18rpx 24rpx; font-size: 25rpx; font-weight: 500; min-height: 72rpx; background: #eaf0f4; color: #617286; border-radius: 40rpx; }
button.filter-chip.selected { background: #087f70; color: #fff; }
.list-caption { display: flex; justify-content: space-between; margin: 24rpx 0 18rpx; font-size: 23rpx; color: #7d8a9a; }
.equipment-top { display: flex; align-items: center; gap: 20rpx; }
.equipment-icon { width: 94rpx; height: 94rpx; border-radius: 20rpx; background: #eef7f3; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.equipment-icon image { width: 54rpx; height: 54rpx; }
.equipment-identity { flex: 1; min-width: 0; }
.equipment-identity .name { margin-bottom: 5rpx; }
.device-meta { display: flex; margin-top: 26rpx; padding: 22rpx; border-radius: 14rpx; background: #f7f9fb; gap: 18rpx; font-size: 25rpx; }
.device-meta > view { flex: 1; min-width: 0; overflow-wrap: break-word; }
.device-meta text { display: block; }
.meta-label { color: #8a96a5; font-size: 23rpx; margin-bottom: 6rpx; }
.device-description { font-size: 25rpx; color: #768395; line-height: 1.7; margin-top: 20rpx; overflow-wrap: break-word; }
.notice { background: #edf3fc; color: #547498; font-size: 23rpx; line-height: 1.8; padding: 20rpx 22rpx; border-radius: 14rpx; margin: 20rpx 0; word-break: break-word; }
.success-notice { background: #eaf7f0; color: #27826a; }
.time-block { padding: 24rpx; margin: 24rpx 0; background: #f6f8fa; border-radius: 16rpx; }
.time-line { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; font-size: 26rpx; }
.time-line .meta-label { margin: 0; flex-shrink: 0; }
.time-dot { flex-shrink: 0; width: 10rpx; height: 10rpx; border: 3rpx solid #087f70; border-radius: 50%; }
.end-dot { border-color: #aebac6; }
.scope-switch .picker { background: #fff; border: 1rpx solid #e6ebf2; display: flex; justify-content: space-between; }
.repair-description { padding: 24rpx 0; font-size: 27rpx; line-height: 1.8; word-break: break-word; }
.repair-steps { display: flex; background: #f7f9fb; padding: 26rpx 8rpx; border-radius: 16rpx; }
.step { flex: 1; text-align: center; color: #99a5b4; font-size: 21rpx; position: relative; }
.step-node { display: block; width: 38rpx; height: 38rpx; line-height: 38rpx; background: #e7ebf0; color: #8492a2; border-radius: 50%; margin: 0 auto 14rpx; }
.step.done { color: #087f70; }.step.done .step-node { background: #087f70; color: #fff; }
button.attachment-button { display: block; width: 100%; padding: 18rpx 0 0; }
button.load-more { background: #fff; color: #7b8797; font-weight: 400; }
.contact-card input { margin-top: 20rpx; }
.profile-hero { padding: 40rpx 30rpx; }
.theme-admin .hero { background: linear-gradient(120deg,#203655,#3d5880); }
.theme-admin .hero .eyebrow, .theme-admin .hero .muted { color: #d0dced; }
.theme-admin button.primary, .theme-admin button.filter-chip.selected, .theme-admin .step.done .step-node { background: #315ee7; color: #fff; }
.theme-admin button.secondary, .theme-admin button.soft-button { background: #edf2ff; color: #315ee7; }
.theme-admin button.text-button, .theme-admin .step.done, .theme-admin .hero-action { color: #315ee7; }
.theme-admin .role-pill { border-color: #d9e2f5; color: #315ee7; }
.theme-admin .quick-symbol:not(.warm), .theme-admin .equipment-icon { color: #315ee7; background: #edf2ff; }
.theme-admin .feed-dot { background: #7292e7; border-color: #eef2fc; }
.theme-admin .compact-equipment { border-left: 6rpx solid #dce5fb; }
.theme-admin .time-dot { border-color: #315ee7; }
